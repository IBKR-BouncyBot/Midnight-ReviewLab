{
  "name": "midnight-reviewlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private expert feedback for AI, built with Midnight Compact and DUST sponsorship",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "compile:fast": "node scripts/compile.mjs --skip-zk",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:proofs": "node scripts/prove.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.64.1"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
