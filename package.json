{
  "name": "midnight-reviewlab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private expert feedback for AI, built with Midnight Compact and DUST sponsorship",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "compile:fast": "node scripts/compile.mjs --skip-zk",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:network-browser": "node scripts/test-network-browser.mjs",
    "test:devnet": "node devnet/run-marketplace.mjs --isolated-local-devnet",
    "test:devnet:browser": "node devnet/browser-acceptance.mjs --isolated-local-devnet",
    "test:proofs": "node scripts/prove.mjs",
    "test:worker-proofs": "node scripts/test-worker-proofs.mjs",
    "test:private-storage": "node devnet/test-private-storage.mjs",
    "test:preview:wasm": "node devnet/preview-wasm-acceptance.mjs --public-preview"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "process": "0.11.10"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.64.1"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
